# Commerce provider — "mock" uses /data/catalog.json; "shopify" uses Storefront API
NEXT_PUBLIC_COMMERCE_PROVIDER=mock

# Shopify (required when NEXT_PUBLIC_COMMERCE_PROVIDER=shopify)
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_STOREFRONT_ACCESS_TOKEN=

# Analytics (optional)
NEXT_PUBLIC_GA4_ID=
