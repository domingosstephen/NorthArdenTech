# ── Site URL ──────────────────────────────────────────────────────────────────
# Used for canonical URLs, OG tags, sitemap, JSON-LD
# No trailing slash. Leave blank locally (defaults to https://northardentech.com)
NEXT_PUBLIC_SITE_URL=https://northardentech.com

# ── Auth.js (next-auth v5) ────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
AUTH_SECRET=

# "From" address for sign-in emails — must be verified in Resend
# e.g. "NorthArdenTech <admin@northardentech.com>"
AUTH_FROM_EMAIL=

# ── Database (Neon Postgres) ──────────────────────────────────────────────────
# Get from Neon dashboard → your project → Connection string
DATABASE_URL=

# ── Stripe ────────────────────────────────────────────────────────────────────
# Publishable key — safe to expose to the browser (NEXT_PUBLIC_ prefix required)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Secret key — server-only, NEVER prefix with NEXT_PUBLIC_
STRIPE_SECRET_KEY=sk_test_...

# Webhook signing secret — from Stripe Dashboard → Webhooks → your endpoint → Signing secret
# Also set for local dev via: stripe listen --forward-to localhost:3000/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Resend (email) ────────────────────────────────────────────────────────────
# Create at resend.com → API Keys
RESEND_API_KEY=re_...

# ── Shippo (shipping labels) ──────────────────────────────────────────────────
SHIPPO_API_KEY=

# Ship-from address (used when purchasing labels via admin)
SHIPPO_FROM_NAME=
SHIPPO_FROM_STREET1=
SHIPPO_FROM_CITY=
SHIPPO_FROM_STATE=
SHIPPO_FROM_ZIP=
SHIPPO_FROM_PHONE=

# ── Cron auth ─────────────────────────────────────────────────────────────────
# Random secret used by /api/cron/* routes to verify Vercel Cron calls
# Generate with: openssl rand -hex 32
CRON_SECRET=

# ── Analytics (optional) ─────────────────────────────────────────────────────
# Google Analytics 4 measurement ID, e.g. "G-XXXXXXXXXX"
NEXT_PUBLIC_GA4_ID=

# ── IMEI encryption ───────────────────────────────────────────────────────────
# AES-256-GCM key for IMEI storage. Generate: openssl rand -hex 32
IMEI_ENCRYPTION_KEY=

# ── Rate limiting (Upstash Redis) ─────────────────────────────────────────────
# Applied to /api/checkout (5 req/min) and /api/orders/lookup (10 req/min).
# Leave blank locally — rate limiting is disabled when these are not set.
# Create a free Redis database at upstash.com → REST API.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── E2E / Playwright ──────────────────────────────────────────────────────────
# Base URL for Playwright tests (defaults to http://localhost:3000)
PLAYWRIGHT_BASE_URL=http://localhost:3000
# Staff email to use in authenticated admin tests
TEST_ADMIN_EMAIL=
# Serialised session cookies JSON from a signed-in admin session
TEST_ADMIN_SESSION=
# A real order UUID to test the order detail + fulfil flows
TEST_ORDER_ID=
# An order UUID with a captured Stripe payment (for refund test)
TEST_REFUNDABLE_ORDER_ID=

# ── Commerce provider (dev) ───────────────────────────────────────────────────
# "mock" → reads /data/catalog.json, in-memory cart (dev default)
# "db"   → Neon Postgres via Drizzle (production / staging)
NEXT_PUBLIC_COMMERCE_PROVIDER=mock
