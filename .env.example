# ── Commerce provider ────────────────────────────────────────────────────────
# "mock"    → reads /data/catalog.json, in-memory cart (dev default)
# "shopify" → Shopify Storefront API (production)
NEXT_PUBLIC_COMMERCE_PROVIDER=mock

# ── Shopify (required when NEXT_PUBLIC_COMMERCE_PROVIDER=shopify) ─────────────
# Your store subdomain, e.g. "my-store.myshopify.com"
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=your-store.myshopify.com

# Storefront API access token — create in Shopify Admin → Apps → Develop apps
# Required scopes: unauthenticated_read_product_listings, unauthenticated_write_checkouts
# This token is server-only — NEVER prefix with NEXT_PUBLIC_
SHOPIFY_STOREFRONT_ACCESS_TOKEN=

# ── Analytics (optional) ─────────────────────────────────────────────────────
# Google Analytics 4 measurement ID, e.g. "G-XXXXXXXXXX"
NEXT_PUBLIC_GA4_ID=

# ── Required Shopify product structure ───────────────────────────────────────
# See /lib/commerce/adapters/shopify.ts for the full setup guide.
# Summary:
#   - Product handle  = family slug (e.g. "iphone-16-pro")
#   - Product tags    = "gen:16", "tier:pro", "status:current"
#   - Product metafields (namespace: northardentech):
#       chip, display, camera, battery_video_hrs, weight, connector,
#       release_year, finish_hex_map (JSON: { "Finish Name": "#hex" })
#   - Variant options (in order): Finish → Storage → Condition
#   - Variant metafields (namespace: northardentech): battery_floor, ships_by
